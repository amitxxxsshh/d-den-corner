# ==========================================
# D DEN CORNER - DEVELOPMENT CONFIGURATION
# ==========================================

# API Base URL for frontends (defaults to http://localhost:8787)
NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional CORS origins for API worker (defaults to localhost:3000 / localhost:3001)
CUSTOMER_ORIGIN=http://localhost:3000
STAFF_ORIGIN=http://localhost:3001

# API environment
APP_ENV=development